{% comment %}
  sections/lookbook-home.liquid

  homepage version. the merchant picks one lookbook through the native
  metaobject field, and then this section sends that handle into the react
  bundle.
{% endcomment %}

{% if section.settings.lookbook %}
  {% comment %}
    react wants a single array of handles, so we wrap the one chosen handle
    in an array that matches the same shape used on product pages.
  {% endcomment %}
  {% assign handle_list = section.settings.lookbook.system.handle | split: ',' %}

  <section
    id="shopify-section-{{ section.id }}"
    class="lookbook-section section-{{ section.id }}"
  >
    <div
      data-lookbook-root
      data-lookbook-handles="{{ handle_list | json | escape }}"
      data-shop-domain="{{ shop.permanent_domain }}"
      data-storefront-token="{{ settings.storefront_api_token }}"
      data-api-version="2025-01"
      data-country="{{ localization.country.iso_code }}"
    ></div>
  </section>

  {{ 'lookbook-bundle.css' | asset_url | stylesheet_tag }}
  {{ 'lookbook-bundle.js' | asset_url | script_tag }}

  {% style %}
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .lookbook__header {
      margin-bottom: {{ section.settings.header_spacing }}px;
    }

    #shopify-section-{{ section.id }} .lookbook__title {
      margin: 0 0 10px;
      color: {{ section.settings.heading_color }};
      font-size: {{ section.settings.heading_size }}px;
      text-align: {{ section.settings.text_alignment }};
      line-height: 1.1;
    }

    #shopify-section-{{ section.id }} .lookbook__description {
      margin: 0 auto;
      width:100%;
      color: {{ section.settings.text_color }};
      font-size: {{ section.settings.description_size }}px;
      line-height: 1.6;
    }

    #shopify-section-{{ section.id }} .lookbook__description {
      margin: 0;
    }

    #shopify-section-{{ section.id }} .lookbook__description {
      text-align: {{ section.settings.text_alignment }};
    }
  {% endstyle %}
{% endif %}

{% schema %}
{
  "name": "Lookbook",
  "settings": [
    {
      "type": "metaobject",
      "id": "lookbook",
      "label": "Lookbook",
      "metaobject_type": "lookbook"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "header_spacing",
      "label": "Header spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description color",
      "default": "#444444"
    }
  ],
  "presets": [
    {
      "name": "Lookbook"
    }
  ]
}
{% endschema %}