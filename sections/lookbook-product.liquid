{% comment %}
  sections/lookbook-product.liquid

  No merchant picker here (that's the spec requirement) — this section
  works out on its own which lookbook(s) contain the current product,
  and shows at most two if the product is in three or more.
{% endcomment %}

{% assign matched_handles = '' %}
{% assign matched_count = 0 %}

{% comment %}
  metaobjects.lookbook.values loops every published "lookbook" metaobject
  entry in the store. On a real catalog you'd want this list cached
  (e.g. via a scheduled Liquid-to-JSON export or a smaller number of
  lookbooks) rather than looped on every product page load, but this is
  the correct native approach for the assessment's scope.
{% endcomment %}
{% for lookbook in metaobjects.lookbook.values %}
  {% comment %}
    lookbook.products is the "products" field (list.single_line_text_field
    — a plain list of handles, per the brief's "handles only" requirement).
    .value unwraps the field into a real array of strings so `contains`
    can check membership.
  {% endcomment %}
  {% if lookbook.products.value contains product.handle %}
    {% if matched_count < 2 %}
      {% comment %} lookbook.system.handle, not lookbook.handle — handle
           lives under .system, same reason as in lookbook-home.liquid {% endcomment %}
      {% assign matched_handles = matched_handles | append: lookbook.system.handle | append: ',' %}
      {% assign matched_count = matched_count | plus: 1 %}
    {% endif %}
  {% endif %}
{% endfor %}

{% assign matched_handles = matched_handles | split: ',' %}

{% if matched_handles.size > 0 %}
  <div
    data-lookbook-root
    data-lookbook-handles="{{ matched_handles | json | escape }}"
    data-shop-domain="{{ shop.permanent_domain }}"
    data-storefront-token="{{ settings.storefront_api_token }}"
    data-api-version="2025-01"
    data-country="{{ localization.country.iso_code }}"
  ></div>

  {{ 'lookbook-bundle.css' | asset_url | stylesheet_tag }}
  {{ 'lookbook-bundle.js' | asset_url | script_tag }}
{% endif %}

  {% style %}
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .lookbook__header {
      margin-bottom: {{ section.settings.header_spacing }}px;
    }

    #shopify-section-{{ section.id }} .lookbook__title {
      margin: 0 0 10px;
      color: {{ section.settings.heading_color }};
      font-size: {{ section.settings.heading_size }}px;
      text-align: {{ section.settings.text_alignment }};
      line-height: 1.1;
    }

    #shopify-section-{{ section.id }} .lookbook__description {
      width: 100%;
      margin: 0 auto;
      color: {{ section.settings.text_color }};
      font-size: {{ section.settings.description_size }}px;
      line-height: 1.6;
      text-align: {{ section.settings.text_alignment }};
    }

    #shopify-section-{{ section.id }} .lookbook__product-title {
      color: {{ section.settings.product_title_color }};
      font-size: {{ section.settings.product_title_size }}px;
      font-weight: {{ section.settings.product_title_weight }};
      text-transform: {{ section.settings.product_title_case }};
    }

    #shopify-section-{{ section.id }} .lookbook__product-price {
      color: {{ section.settings.product_price_color }};
      font-size: {{ section.settings.product_price_size }}px;
      font-weight: {{ section.settings.product_price_weight }};
      text-transform: {{ section.settings.product_price_case }};
    }

    #shopify-section-{{ section.id }} .lookbook__product-compare-at {
      color: {{ section.settings.product_compare_at_color }};
    }
  {% endstyle %}
{% schema %}
{
  "name": "Lookbook (product page)",
  "settings": [
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "header_spacing",
      "label": "Header spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description color",
      "default": "#444444"
    },
    {
      "type": "header",
      "content": "Product Text Customization"
    },
    {
      "type": "color",
      "id": "product_title_color",
      "label": "Product title color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "product_title_size",
      "label": "Product title size",
      "min": 10,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "product_title_weight",
      "label": "Product title weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "select",
      "id": "product_title_case",
      "label": "Product title case",
      "options": [
        { "value": "none", "label": "Default" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "product_price_color",
      "label": "Product price color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "product_price_size",
      "label": "Product price size",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "product_price_weight",
      "label": "Product price weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    {
      "type": "select",
      "id": "product_price_case",
      "label": "Product price case",
      "options": [
        { "value": "none", "label": "Default" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "product_compare_at_color",
      "label": "Compare at price color",
      "default": "#888888"
    }
  ],
  "presets": [
    {
      "name": "Lookbook (product page)"
    }
  ]
}
{% endschema %}